# ---------------------------------------------------------------
# .gitignore — ZEROFORM Sparse Matrix Studio
# Tracks source and tests only; ignores all build artifacts.
# ---------------------------------------------------------------

# Compiled executables (Windows & Linux)
*.exe
c_engine/zeroform
c_engine/zeroform_*

# Object files and dependency files
*.o
*.d

# Static and import libraries produced by MinGW
*.a
*.lib

# Dynamic libraries
*.dll
*.so
*.dylib

# Build output directories
build/
dist/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/
.pytest_cache/

# Flask / Werkzeug session files
flask_session/

# Local environment & secret files
.env
.env.*
*.local

# Editor and IDE metadata
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
Thumbs.db
.DS_Store
desktop.ini

# Temporary files
*.tmp
*.bak
*.log
